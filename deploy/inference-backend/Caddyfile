# TLS front for the Voice Suite backend (docker compose --profile https).
# Caddy obtains and renews a Let's Encrypt certificate for the domain; ports
# 80 and 443 must reach this host. Long uploads and generations are allowed.
{$VOICE_SUITE_BACKEND_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 2GB
	}
	reverse_proxy 127.0.0.1:3900 {
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}
