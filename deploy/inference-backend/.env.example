# Copy to deploy/inference-backend/.env (git-ignored) and fill in.
# Never commit the real file.

# Long random secret; generate with:  openssl rand -base64 48
OMNIVOICE_API_KEY=

# Exact origin(s) of the hosted frontend, comma-separated, no trailing slash.
OMNIVOICE_ALLOWED_ORIGINS=https://voice-suite.vercel.app

# Public DNS name of this backend, used by the optional `https` profile.
VOICE_SUITE_BACKEND_DOMAIN=voice-backend.example.com

# Optional Hugging Face token (only for gated models you have accepted).
HF_TOKEN=

# 1 keeps opt-in analytics off for this server regardless of the UI.
OMNIVOICE_ANALYTICS_DISABLED=1

# Set to 1 to lock Commercial Production Guard on (blocks CC-BY-NC and unverified weights).
OMNIVOICE_COMMERCIAL_ONLY=0
