# Voice Suite — frontend build configuration (example; no secrets belong here).
# Backend variables live in deploy/inference-backend/.env.example.
# See docs/handover/ENVIRONMENT.md.

# Build the static hosted bundle (Vercel sets this in vercel.json).
VOICE_SUITE_HOSTED=1

# Optional default inference backend for the hosted site. Public: it is baked into
# the JavaScript bundle. Users can change it in Settings → Sharing → Remote backend.
VITE_VOICE_SUITE_BACKEND_URL=

# Optional: 1 stops the GitHub star badge from calling api.github.com.
VITE_PREVIEW_OFFLINE=
